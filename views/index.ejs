<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Porkmon Characters</title>
    <style>
        :root{
        --bg:skyblue;
        }

        *{
            margin: 0;
            padding: 0;
        }

     
 @media screen and (min-width:320px) and (max-width: 767px) {
  /* Styles for all mobile views */
  body{
    background-color: var(--bg);
    width: 100%;
  }
  
  header{
    background-color: rgb(10, 4, 0);
    color: #eee;
    line-height: 1.7;
    font-weight: 600;
    font-family: Cambria, Cochin, Georgia, Times, 'Times New Roman', serif;
    font-size: 1.3rem;
    padding: .5em;
  }

  main{
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
    padding: 1em;
  }
  main > div > a{
    text-decoration: none;
    color: rgb(5, 4, 0);
    font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
    line-height: 1.7;
    font-weight: 600;
  }
  main > div{
    background-color: white;
    padding: .5em;
    border-radius: 5px;
    box-shadow: 1px 2px 2px 1px rgba(0, 0, 0, 0.3);
  }
 }
 
    </style>
</head>
<body>
    <header>Porkmon Characters</header>

    <main>
      <% for(let i of locals.data){ %>
        <div><a href=<%=`/${i.Name}`%>><%= i.Name %></a></div>
        <%} %>
    </main>
</body>
</html>